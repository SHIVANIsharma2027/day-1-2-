class Queue:
    def __init__(self, max_size):
        self.queue = []
        self.max_size = max_size

    def is_full(self):
        return len(self.queue) == self.max_size

    def is_empty(self):
        return len(self.queue) == 0

    def enqueue(self, floor):
        if self.is_full():
            print("Request queue is full!")
        else:
            self.queue.append(floor)

    def dequeue(self):
        if self.is_empty():
            print("No requests in the queue!")
            return None
        else:
            return self.queue.pop(0)

    def display(self):
        if self.is_empty():
            print("No requests in the queue.")
        else:
            print("Current requests in the queue:", ' '.join(map(str, self.queue)))


def manage_lift(queue):
    while not queue.is_empty():
        next_floor = queue.dequeue()
        print(f"Lift moving to floor {next_floor}...")
        # Simulating delay for moving between floors
        import time
        time.sleep(1)  # Simulate a delay
        print(f"Lift arrived at floor {next_floor}.")


def main():
    max_floors = 10
    max_queue_size = 20
    queue = Queue(max_queue_size)

    while True:
        print("\nLift Management System")
        print("1. Request Lift")
        print("2. Show Requests")
        print("3. Manage Lift")
        print("4. Exit")
        choice = int(input("Enter your choice: "))

        if choice == 1:
            floor = int(input(f"Enter floor number (0-{max_floors - 1}): "))
            if 0 <= floor < max_floors:
                queue.enqueue(floor)
                print(f"Lift requested from floor {floor}.")
            else:
                print("Invalid floor number!")
        elif choice == 2:
            queue.display()
        elif choice == 3:
            manage_lift(queue)
        elif choice == 4:
            print("Exiting Lift Management System.")
            break
        else:
            print("Invalid choice! Please try again.")


if __name__ == "__main__":
    main()
    
            




      
