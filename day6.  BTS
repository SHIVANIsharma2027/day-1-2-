# Python program to demonstrate insert operation in binary search tree


class Node:
    def __init__(self, key):
        self.left = None
        self.right = None
        self.val = key


# A utility function to insert a new node with the given key
def insert(root, key):
    if root is None:
        return Node(key)
    if root.val == key:
        return root
    if root.val < key:
        root.right = insert(root.right, key)
    else:
        root.left = insert(root.left, key)
    return root


# A utility function to do inorder tree traversal
def inorder(root):
    if root:
        inorder(root.left)
        print(root.val, end=" ")
        inorder(root.right)


# A utility function to do preorder tree traversal
def preorder(root):
    if root:
        print(root.val, end=" ")  # Visit node
        preorder(root.left)        # Traverse left subtree
        preorder(root.right)       # Traverse right subtree


# A utility function to do postorder tree traversal
def postorder(root):
    if root:
        postorder(root.left)       # Traverse left subtree
        postorder(root.right)      # Traverse right subtree
        print(root.val, end=" ")   # Visit node


# Creating the following BST
#      50
#     /  \
#    30   70
#   / \   / \
#  20 40 60 80
r = Node(50)
r = insert(r, 30)
r = insert(r, 20)
r = insert(r, 40)
r = insert(r, 70)
r = insert(r, 60)
r = insert(r, 80)

# Print inorder traversal of the BST
print("Inorder Traversal:", end=" ")
inorder(r)
print()  # New line

# Print preorder traversal of the BST
print("Preorder Traversal:", end=" ")
preorder(r)
print()  # New line

# Print postorder traversal of the BST
print("Postorder Traversal:", end=" ")
postorder(r)
print()  # New line


## Deletion 

# Python program to demonstrate insert and delete operation in binary search tree
class Node:
    def __init__(self, key):
        self.left = None
        self.right = None
        self.val = key


# A utility function to insert a new node with the given key
def insert(root, key):
    if root is None:
        return Node(key)
    if root.val < key:
        root.right = insert(root.right, key)
    else:
        root.left = insert(root.left, key)
    return root


# A utility function to delete a node with the given key
def deleteNode(root, key):
    # Base Case: If the tree is empty
    if root is None:
        return root

    # Recursive calls for ancestors of the node to be deleted
    if key < root.val:
        root.left = deleteNode(root.left, key)
    elif key > root.val:
        root.right = deleteNode(root.right, key)
    else:
        # Node with only one child or no child
        if root.left is None:
            return root.right
        elif root.right is None:
            return root.left

        # Node with two children: Get the inorder successor
        temp = minValueNode(root.right)
        root.val = temp.val  # Copy the inorder successor's value to this node
        root.right = deleteNode(root.right, temp.val)  # Delete the inorder successor

    return root


# A utility function to find the node with the minimum value in the given tree
def minValueNode(node):
    current = node
    while current.left is not None:
        current = current.left
    return current


# A utility function to do inorder tree traversal
def inorder(root):
    if root:
        inorder(root.left)
        print(root.val, end=" ")
        inorder(root.right)


# A utility function to do preorder tree traversal
def preorder(root):
    if root:
        print(root.val, end=" ")  # Visit node
        preorder(root.left)        # Traverse left subtree
        preorder(root.right)       # Traverse right subtree


# A utility function to do postorder tree traversal
def postorder(root):
    if root:
        postorder(root.left)       # Traverse left subtree
        postorder(root.right)      # Traverse right subtree
        print(root.val, end=" ")   # Visit node


# Creating the following BST
#      50
#     /  \
#    30   70
#   / \   / \
#  20 40 60 80
r = Node(50)
r = insert(r, 30)
r = insert(r, 20)
r = insert(r, 40)
r = insert(r, 70)
r = insert(r, 60)
r = insert(r, 80)

# Print inorder traversal of the BST
print("Inorder Traversal before deletion:", end=" ")
inorder(r)
print()  # New line

# Print preorder traversal of the BST
print("Preorder Traversal before deletion:", end=" ")
preorder(r)
print()  # New line

# Print postorder traversal of the BST
print("Postorder Traversal before deletion:", end=" ")
postorder(r)
print()  # New line

# Deleting nodes
r = deleteNode(r, 20)
print("Inorder Traversal after deleting 20:", end=" ")
inorder(r)
print()  # New line

r = deleteNode(r, 30)
print("Inorder Traversal after deleting 30:", end=" ")
inorder(r)
print()  # New line

r = deleteNode(r, 50)
print("Inorder Traversal after deleting 50:", end=" ")
inorder(r)
print()  # New line

# Final traversals after deletions
print("Final Inorder Traversal:", end=" ")
inorder(r)
print()  # New line

print("Final Preorder Traversal:", end=" ")
preorder(r)
print()  # New line

print("Final Postorder Traversal:", end=" ")
postorder(r)
print()  # New line




